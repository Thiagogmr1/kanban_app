<%= form_with(model: board) do |form| %>
  <% if board.errors.any? %>
    <div class="form-errors">
      <h2 class="form-errors-title">
        <%= pluralize(board.errors.count, "erro") %> impediram este quadro de ser salvo:
      </h2>

      <ul class="form-errors-list">
        <% board.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :name, "Nome do quadro" %>
    <%= form.text_field :name, placeholder: "Ex: Projeto Pessoal", autofocus: true %>
  </div>

  <div class="form-actions">
    <%= form.submit "Criar quadro", class: "form-submit" %>
  </div>
<% end %>